# Postgres connection string.
# In production this is auto-injected when you connect a Neon database
# to your Vercel project (Storage tab → Create Database → Neon).
# Vercel typically sets DATABASE_URL; older projects may use POSTGRES_URL.
# Only needed locally if you want to run `vercel dev` against a real database;
# `vercel env pull` will write a .env.development.local file for you.
DATABASE_URL=

# Password used to sign in to the admin dashboard at /admin.
# Pick anything you can remember. After login the server sets an HttpOnly
# cookie so you stay signed in on that device for ~30 days.
ADMIN_PASSWORD=

# Optional: enables email alerts to the host when someone submits an RSVP.
# Sign up at resend.com (free tier), create an API key, paste it here.
# The actual recipient email is set inside the /admin dashboard, not here.
# Leave this unset to disable email notifications entirely.
RESEND_API_KEY=

# Optional: enables SMS text reminders via Textbelt (textbelt.com).
# Buy credits at textbelt.com — ~$0.01/text, no A2P registration needed.
# Once set, the "Send Text Reminders" section appears in /admin.
TEXTBELT_API_KEY=
